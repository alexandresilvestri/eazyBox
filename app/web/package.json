{
  "name": "@eazybox/web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --hot server/server.ts",
    "start": "bun server/server.ts",
    "migrate": "bunx knex migrate:latest --knexfile server/db/knexfile.ts",
    "migrate:rollback": "bunx knex migrate:rollback --knexfile server/db/knexfile.ts",
    "migrate:make": "bunx knex migrate:make --knexfile server/db/knexfile.ts -x ts",
    "seed": "bunx knex seed:run --knexfile server/db/knexfile.ts",
    "seed:make": "bunx knex seed:make --knexfile server/db/knexfile.ts -x ts",
    "test": "bun test --parallel=1",
    "test:watch": "bun test --parallel=1 --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "bunx eslint . --fix",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "admin:create": "bun server/scripts/create-admin.ts",
    "tokens": "bun scripts/tokens.ts"
  },
  "dependencies": {
    "@eazybox/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@sentry/bun": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@tabler/icons-react": "^3.46.0",
    "bun-plugin-tailwind": "^0.1.2",
    "camelcase-keys": "^10.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "knex": "^3.1.0",
    "lodash": "^4.18.1",
    "pg": "^8.13.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "knex-cleaner": "^1.3.1",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
