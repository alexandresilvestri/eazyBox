{
  "name": "@eazybox/web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --hot server/server.ts",
    "start": "bun server/server.ts",
    "migrate": "bunx knex migrate:latest --knexfile server/db/knexfile.ts",
    "migrate:rollback": "bunx knex migrate:rollback --knexfile server/db/knexfile.ts",
    "migrate:make": "bunx knex migrate:make --knexfile server/db/knexfile.ts -x ts",
    "test": "bun test --parallel=1",
    "test:watch": "bun test --parallel=1 --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "bunx eslint . --fix",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "admin:create": "bun server/scripts/create-admin.ts",
    "db:seed": "bun server/scripts/seed.ts"
  },
  "dependencies": {
    "@eazybox/shared": "workspace:*",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@sentry/bun": "^10.71.0",
    "bun-plugin-tailwind": "^0.1.2",
    "camelcase-keys": "^10.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.4",
    "jose": "^6.2.10",
    "knex": "^3.1.0",
    "lodash": "^4.18.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "knex-cleaner": "^1.3.1",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
