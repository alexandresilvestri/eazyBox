{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "image": "latest",
      "bun": "1.3.14",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "image": "latest",
      "bun": "1.3.14",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://PLACEHOLDER.eazybox.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "image": "latest",
      "bun": "1.3.14",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://PLACEHOLDER.eazybox.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
