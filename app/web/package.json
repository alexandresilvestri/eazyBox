{
  "name": "@eazybox/web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --hot server/server.ts",
    "start": "NODE_ENV=development bun server/server.ts",
    "build": "bun build ./client/index.html --outdir ./dist --minify",
    "migrate": "bunx knex migrate:latest --knexfile server/db/knexfile.ts",
    "migrate:rollback": "bunx knex migrate:rollback --knexfile server/db/knexfile.ts",
    "migrate:make": "bunx knex migrate:make --knexfile server/db/knexfile.ts -x ts",
    "seed": "bunx knex seed:run --knexfile server/db/knexfile.ts",
    "seed:make": "bunx knex seed:make --knexfile server/db/knexfile.ts -x ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eazybox/shared": "workspace:*",
    "camelcase-keys": "^10.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "knex": "^3.1.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.30.0",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/pg": "^8.21.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "typescript": "^7.0.2",
    "@types/bun": "latest"
  }
}
