{
  "name": "@eazybox/web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "start": "NODE_ENV=development bun server/index.ts",
    "build": "bun build ./src/index.html --outdir ./dist --minify",
    "migrate": "bunx knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "bunx knex migrate:rollback --knexfile knexfile.ts",
    "migrate:make": "bunx knex migrate:make --knexfile knexfile.ts -x ts",
    "seed": "bunx knex seed:run --knexfile knexfile.ts",
    "seed:make": "bunx knex seed:make --knexfile knexfile.ts -x ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eazybox/shared": "workspace:*",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/pg": "^8.11.10",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "typescript": "^7.0.2",
    "@types/bun": "latest"
  }
}
