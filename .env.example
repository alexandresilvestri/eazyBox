# Ambiente
NODE_ENV=development
PORT=3000

# PostgreSQL (usado pelo Knex)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db

# Alternativa: string de conexão única
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db

# Redis
REDIS_URL=redis://localhost:6379
