{
  "name": "eazybox",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "app/*",
    "shared"
  ],
  "scripts": {
    "dev": "bun run --filter @eazybox/web dev",
    "mobile": "bun run --filter @eazybox/mobile start",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/bun": "latest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0"
  }
}
